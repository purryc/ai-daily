{
  "name": "ai-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/render-site.mjs",
    "pdf": "node scripts/export-pdfs.mjs",
    "pdf:static": "node scripts/export-static-pdfs.mjs",
    "build:all": "npm run build && npm run pdf",
    "check": "node scripts/check-site.mjs",
    "test": "node --test tests/*.test.mjs tests/browser/*.test.mjs",
    "issue": "node scripts/create-issue.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "test:all": "npm test",
    "test:unit": "node --test tests/*.test.mjs",
    "cloud:preflight": "node scripts/cloud-run.mjs preflight",
    "cloud:plan": "node scripts/cloud-run.mjs plan",
    "cloud:build": "node scripts/cloud-run.mjs build",
    "cloud:prepare-release": "node scripts/prepare-release.mjs",
    "ledger:ingest": "node scripts/cloud-ledger.mjs",
    "weekly:build": "node scripts/weekly.mjs build",
    "weekly:check": "node scripts/weekly.mjs check"
  },
  "devDependencies": {
    "playwright": "^1.61.0"
  }
}
